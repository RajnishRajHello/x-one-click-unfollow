{
  "manifest_version": 3,
  "name": "X One-Click Unfollow",
  "version": "1.0",
  "description": "Bypasses the unfollow confirmation modal on X (Twitter).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
